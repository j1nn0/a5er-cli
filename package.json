{
  "name": "@j1nn0/a5er-cli",
  "version": "0.1.2",
  "description": "Read-only CLI for A5:SQL Mk-2 ER diagram (.a5er) files",
  "homepage": "https://github.com/j1nn0/a5er-cli#readme",
  "bugs": "https://github.com/j1nn0/a5er-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j1nn0/a5er-cli.git"
  },
  "bin": {
    "a5er": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "pnpm exec oxlint src tests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.12"
}
